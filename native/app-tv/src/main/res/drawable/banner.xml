<?xml version="1.0" encoding="utf-8"?>
<!--
  电视端桌面 banner（320x180）。

  Leanback 启动器的应用列表读的是 android:banner，不是 android:icon ——
  没有自己的 banner 时，系统会塞一个通用的"播放三角"占位图，
  看起来像另一个 App。这里用手绘矢量，和手机端图标同一套图形语言。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:pathData="M0,0h320v180h-320z"
        android:fillColor="#12151C" />
    <!-- 左侧一条极淡的高光，避免整块纯色显得死板 -->
    <path
        android:pathData="M0,0h150v180h-150z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="150"
                android:endY="180"
                android:type="linear"
                android:startColor="#1A1F2A"
                android:endColor="#12151C" />
        </aapt:attr>
    </path>

    <group android:translateX="106" android:translateY="36">
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="1.6"
            android:scaleY="1.6">
            <path
                android:pathData="M37,25 L85,54 L37,83 Z"
                android:fillColor="#FFCF7A"
                android:strokeColor="#FFCF7A"
                android:strokeWidth="9"
                android:strokeLineJoin="round" />
            <group
                android:translateX="41"
                android:translateY="39"
                android:scaleX="1.2"
                android:scaleY="1.2">
                <path
                    android:pathData="M12,3v10.55A4,4 0 1,0 14,17V7h4V3h-6z"
                    android:fillColor="#12151C" />
            </group>
        </group>
    </group>
</vector>
