<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏的「小播放界面」。

  和迷你条同构：左边封面，右边歌名 + 当前歌词；下面进度；最下面五个按钮。
  用自定义 RemoteViews 而不是 MediaStyle：系统的媒体卡片布局固定为
  「应用图标 + 歌名 + 歌手 + 三个按钮」，放不下封面和循环/收藏。

  注意：RemoteViews 只支持 LinearLayout/FrameLayout/RelativeLayout/TextView/
  ImageView/ProgressBar 这些老控件，不能用 ConstraintLayout / CardView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="6dp">

    <!-- 上半：封面 + 文字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/n_cover"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/notif_cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFF4F5F7" />

            <!-- 第二行放歌词：迷你条也是这么做的，比重复一遍歌手名有用 -->
            <TextView
                android:id="@+id/n_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="#FFB3B8C3" />
        </LinearLayout>
    </LinearLayout>

    <!-- 进度：细条，和迷你条顶部那条同宽 -->
    <ProgressBar
        android:id="@+id/n_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FFE0A34B"
        android:progressBackgroundTint="#33000000" />

    <!-- 下半：循环 / 上一首 / 播放 / 下一首 / 收藏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/n_repeat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/notif_repeat" />

        <ImageButton
            android:id="@+id/n_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/notif_prev" />

        <ImageButton
            android:id="@+id/n_play"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/notif_play" />

        <ImageButton
            android:id="@+id/n_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/notif_next" />

        <ImageButton
            android:id="@+id/n_fav"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/notif_fav" />
    </LinearLayout>
</LinearLayout>
