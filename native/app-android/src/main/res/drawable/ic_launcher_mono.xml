<?xml version="1.0" encoding="utf-8"?>
<!--
  单色层（monochrome）。Android 13+ 用它画：
    · 桌面「主题图标」着色
    · **状态栏的媒体播放指示器**（正在播放时那颗小图标）
  没有这一层时，系统会拿一个通用图形兜底 —— 表现就是"通知栏图标和 App 不一样"。
  形状与 ic_launcher_fg 完全一致，只是系统会忽略颜色、自己上色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="30" android:translateY="30"
        android:scaleX="2" android:scaleY="2">
        <path
            android:pathData="M12,3v10.55A4,4 0 1,0 14,17V7h4V3h-6z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
